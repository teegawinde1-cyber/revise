PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# JSON du compte de service Firebase sur une seule ligne, secret serveur uniquement.
# Fichier privé placé localement dans server/, ignoré par Git.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Alternative pour un hébergeur : JSON complet dans un secret serveur.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Fournisseur IA compatible OpenAI
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
AI_HTTP_REFERER=
AI_APP_TITLE=ReviseBac
