rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les accès directs client sont bloqués. Le serveur Admin contourne ces règles.
    // L'API actuelle utilise un identifiant d'appareil pseudonyme, pas une authentification sécurisée.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
